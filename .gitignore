__pycache__/
*.pyc
.venv/
# Per-run artifacts: per-example losses and generations. Regenerable, and the
# .npy files add up fast. runs.jsonl itself IS committed -- it is the results.
results/runs/*
!results/runs/.gitkeep

results/figures/*_demo.*

# Cached per-example scores. Large, regenerable, and machine-specific timings live
# in the accompanying .json -- the SELECTION artifacts are what get committed.
results/scores/
